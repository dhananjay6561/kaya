{
  "name": "@kaya/core",
  "version": "0.1.0",
  "private": true,
  "description": "Kaya's agent: commands, LLM calls, tools, safety rules and scheduler",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "tsx --test --test-timeout=60000 \"src/**/*.test.ts\"",
    "contracts:types": "tsx src/contracts/generate-types.ts"
  },
  "dependencies": {
    "@kaya/contracts": "0.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "gpt-tokenizer": "4.1.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "json-schema-to-typescript": "16.0.0"
  }
}
