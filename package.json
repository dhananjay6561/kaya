{
  "name": "kaya",
  "private": true,
  "description": "A self-hosted personal agent that lives on WhatsApp",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "core"
  ],
  "scripts": {
    "dev": "npm run dev -w @kaya/core",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
